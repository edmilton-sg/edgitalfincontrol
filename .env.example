# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Estas variáveis são PÚBLICAS por natureza: em um app Vite elas vão embutidas
# no bundle do front-end e ficam visíveis no navegador. A segurança do banco
# depende das políticas de Row Level Security (RLS) no Supabase, e NÃO do
# sigilo destas chaves. Nunca coloque aqui chaves secretas (ex.: service_role).
# Copie este arquivo para `.env` e preencha com os valores do seu projeto.
# ---------------------------------------------------------------------------

VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-do-supabase"
